    {
      "id": "elision",
      "title": "Elize: l', j', n', qu'",
      "fr": "l'élision",
      "level": "A1",
      "keywords": [
        "elision",
        "apostrophe",
        "l'",
        "j'",
        "n'",
        "qu'",
        "d'",
        "s'il",
        "m'",
        "t'",
        "élision",
        "h muet",
