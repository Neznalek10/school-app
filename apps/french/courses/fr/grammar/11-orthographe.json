      "sections": [
        {
          "title": "Ve zkratce",
          "blocks": [
            {
              "type": "text",
              "cs": "Francouzská diakritika samohlásku **neprodlužuje** jako česká čárka. Mění její zvuk, nebo jen rozlišuje dvě slova."
            },
            {
              "type": "table",
              "head": [
                "znaménko",
                "příklad",
                "co dělá"
              ],
              "textCols": [
                0,
                2
              ],
              "rows": [
                [
                  "accent aigu ´",
                  "é: été, café",
                  "zavřené e, krátké"
                ],
                [
                  "accent grave `",
                  "è: père, très",
                  "otevřené e"
                ],
                [
                  "à, ù",
                  "à, où",
                  "jen rozlišuje slova"
                ],
                [
                  "accent circonflexe ^",
                  "ê, â, î, ô, û: fête, château",
                  "často místo zaniklého *s*"
                ],
                [
                  "tréma ¨",
                  "ë, ï: Noël, maïs",
                  "samohlásky se vyslovují zvlášť"
                ],
                [
                  "cédille ¸",
                  "ç: français, garçon",
                  "*c* zní jako s i před a, o, u"
                ]
              ]
            }
          ]
        },
        {
          "title": "Slova, která rozlišuje diakritika",
          "blocks": [
            {
              "type": "table",
              "head": [
                "bez diakritiky",
                "s diakritikou"
              ],
              "rows": [
                [
                  "a (il a = má)",
                  "à (do, v)"
                ],
                [
                  "ou (nebo)",
                  "où (where)"
                ],
                [
                  "la (člen)",
                  "là (there)"
                ],
                [
                  "sur (na)",
                  "sûr (sure)"
                ]
              ]
            },
            {
              "type": "tip",
              "cs": "Diakritiku můžeš psát tlačítky pod polem pro odpověď. Jestli se chybějící diakritika počítá jako chyba, nastavíš v Nastavení."
            }
          ]
        },
        {
          "title": "Příklady",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Mon frère est très grand.",
                  "cs": "Můj bratr je hodně vysoký."
                },
                {
                  "fr": "Où est la gare ?",
                  "cs": "Kde je nádraží?"
                },
