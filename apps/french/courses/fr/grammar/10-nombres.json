    {
      "id": "numbers-more",
      "title": "Další čísla: desetinná čísla, zlomky, procenta, odhady",
      "fr": "les nombres (suite)",
      "level": "A2",
      "levelTo": "B1",
      "keywords": [
        "decimals",
        "virgule",
        "fractions",
        "la moitié",
        "un tiers",
        "un quart",
        "pourcentage",
        "pour cent",
