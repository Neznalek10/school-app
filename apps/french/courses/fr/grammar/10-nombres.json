      "sections": [
        {
          "title": "Ve zkratce",
          "blocks": [
            {
              "type": "text",
              "cs": "Řadové číslovky se tvoří přidáním *-ième* k číslu: *deux → deuxième*. Zvláštní je jen \"první\": *premier, première*."
            },
            {
              "type": "table",
              "head": [
                "česky",
                "francouzsky",
                "zkratka"
              ],
              "textCols": [
                0
              ],
              "rows": [
                [
                  "první",
                  "premier, première",
                  "1er, 1re"
                ],
                [
                  "druhý",
                  "deuxième (second)",
                  "2e"
                ],
                [
                  "třetí",
                  "troisième",
                  "3e"
                ],
                [
                  "čtvrtý",
                  "quatrième",
                  "4e"
                ],
                [
                  "pátý",
                  "cinquième",
                  "5e"
                ],
                [
                  "devátý",
                  "neuvième",
                  "9e"
                ],
                [
                  "dvacátý první",
                  "vingt et unième",
                  "21e"
                ],
                [
                  "poslední",
                  "dernier, dernière",
                  ""
                ]
              ]
            }
          ]
        },
        {
          "title": "Pravopis",
          "blocks": [
            {
              "type": "text",
              "cs": "Koncové *-e* odpadá: *quatre → quatrième, onze → onzième*. *Cinq* přidává *u*: *cinquième*. *Neuf* mění *f* na *v*: *neuvième*."
            }
          ]
        },
        {
          "title": "Kde se používají",
          "blocks": [
            {
              "type": "text",
              "cs": "Patra (*au troisième étage*), pořadí (*la deuxième rue à droite*), poprvé (*la première fois*). V datech je řadová jen první: *le premier mai*, ale *le deux mai*."
            },
            {
              "type": "see",
              "rules": [
                "dates"
              ]
            }
          ]
        },
        {
          "title": "Příklady",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "C'est la première fois.",
                  "cs": "Je to poprvé."
                },
                {
                  "fr": "J'habite au cinquième étage.",
                  "cs": "Bydlím v pátém patře."
                },
                {
                  "fr": "Prenez la deuxième rue à gauche.",
                  "cs": "Jděte druhou ulicí doleva."
                },
                {
                  "fr": "Il est arrivé troisième.",
                  "cs": "Skončil třetí."
                },
                {
                  "fr": "C'est le dernier jour des vacances.",
                  "cs": "Je poslední den prázdnin."
                }
              ]
            }
          ]
        }
      ],
