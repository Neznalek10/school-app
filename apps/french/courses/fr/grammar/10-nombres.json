      "sections": [
        {
          "title": "Ve zkratce",
          "blocks": [
            {
              "type": "text",
              "cs": "Od 70 počítá francouzština po dvacítkách. Vypadá to složitě, ale stačí sčítat."
            },
            {
              "type": "table",
              "head": [
                "číslo",
                "francouzsky",
                "doslova"
              ],
              "textCols": [
                0,
                2
              ],
              "rows": [
                [
                  "70",
                  "soixante-dix",
                  "60 + 10"
                ],
                [
                  "71",
                  "soixante et onze",
                  "60 + 11"
                ],
                [
                  "75",
                  "soixante-quinze",
                  "60 + 15"
                ],
                [
                  "80",
                  "quatre-vingts",
                  "4 × 20"
                ],
                [
                  "81",
                  "quatre-vingt-un",
                  "4 × 20 + 1"
                ],
                [
                  "90",
                  "quatre-vingt-dix",
                  "4 × 20 + 10"
                ],
                [
                  "99",
                  "quatre-vingt-dix-neuf",
                  "4 × 20 + 19"
                ],
                [
                  "100",
                  "cent",
                  "100"
                ]
              ]
            }
          ]
        },
        {
          "title": "Pravopis",
          "blocks": [
            {
              "type": "text",
              "cs": "*Quatre-vingts* má *-s* jen tehdy, když za ním nic nenásleduje: *quatre-vingts*, ale *quatre-vingt-trois*. U 81 a 91 už **není** *et*."
            },
            {
              "type": "compare",
              "items": [
                {
                  "cs": "80",
                  "wrong": "quatre-vingt",
                  "fr": "quatre-vingt[[s]]"
                },
                {
                  "cs": "81",
                  "wrong": "quatre-vingt et un",
                  "fr": "quatre-vingt-[[un]]"
                }
              ]
            },
            {
              "type": "tip",
              "title": "Belgie a Švýcarsko",
              "cs": "V Belgii a ve Švýcarsku se říká *septante* (70) a *nonante* (90), ve Švýcarsku i *huitante* (80). Ve Francii a ve škole platí *soixante-dix* a *quatre-vingt-dix*."
            }
          ]
        },
        {
          "title": "Příklady",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Ma grand-mère a soixante-dix-huit ans.",
                  "cs": "Babičce je sedmdesát osm."
                },
                {
                  "fr": "Ça coûte quatre-vingts euros.",
                  "cs": "Stojí to osmdesát eur."
                },
                {
                  "fr": "Il y a quatre-vingt-dix-neuf verbes dans l'appli.",
                  "cs": "V aplikaci je devadesát devět sloves."
                },
                {
                  "fr": "Mon grand-père a quatre-vingt-un ans.",
                  "cs": "Dědovi je osmdesát jedna."
                }
              ]
            }
          ]
        }
      ],
