    {
      "id": "im-03-negative",
      "title": "Krok 3: Záporné rozkazy: Ne fais pas ça !",
      "fr": "l'impératif négatif",
      "level": "A1",
      "keywords": [
        "step by step",
        "imperative",
        "negative command",
        "ne pas",
        "don't",
        "ne fais pas",
        "ne dis rien"
      ],
      "topics": [],
      "see": [
        "imperative",
        "ne-pas"
      ],
      "sections": [
        {
          "title": "Ve zkratce",
          "blocks": [
            {
              "type": "text",
              "cs": "Dej **ne** před sloveso a **pas** za něj, jako u každého záporu: *Ne parle pas ! N'oublie pas !* Fungují i ostatní záporná slova: *Ne dis rien ! Ne fais jamais ça !*"
            },
            {
              "type": "pattern",
              "rows": [
                {
                  "parts": [
                    [
                      "neg",
                      "Ne"
                    ],
                    [
                      "V",
                      "parle"
                    ],
                    [
                      "neg",
                      "pas !"
                    ]
                  ],
                  "cs": "Nemluv!"
                },
                {
                  "parts": [
                    [
                      "neg",
                      "N'"
                    ],
                    [
                      "V",
                      "oubliez"
                    ],
                    [
                      "neg",
                      "pas"
                    ],
                    [
                      "obj",
                      "vos livres !"
                    ]
                  ],
                  "cs": "Nezapomeň si knihy!"
                }
              ],
              "formula": [
                "neg",
                "V",
                "neg"
              ]
            }
          ]
        },
        {
          "title": "Ne ... pas",
          "blocks": [
            {
              "type": "text",
              "cs": "*Ne* se před samohláskou mění na *n'*: *N'ouvre pas ! N'ayez pas peur !* *Un, une, du, des* se mění na **de**: *Faites du bruit → Ne faites pas de bruit !*"
            },
            {
              "type": "check",
              "item": {
                "type": "transform",
                "task_cs": "Převeď rozkaz do záporu",
                "fr": "Mange !",
                "a": [
                  "Ne mange pas !"
                ]
              }
            }
          ]
        },
        {
          "title": "Další záporná slova",
          "blocks": [
            {
              "type": "text",
              "cs": "*Ne ... jamais* (nikdy), *ne ... plus* (už ne), *ne ... rien* (nic), *ne ... personne* (nikdo): *Ne mange plus de bonbons ! Ne dis rien à personne !*"
            },
            {
              "type": "check",
              "item": {
                "type": "build",
                "cs": "Nic neříkej! (tu)",
                "a": [
                  "Ne dis rien !"
                ]
              }
            }
          ]
        },
        {
          "title": "Pozor",
          "blocks": [
            {
              "type": "tip",
              "cs": "Mluvená francouzština někdy *ne* vynechává (*Fais pas ça !*). V psaní ho nech."
            },
            {
              "type": "tip",
              "cs": "Krátký nápis může být jen *pas de* + podstatné jméno: *Pas de bruit !* (Ticho!)"
            }
          ]
        },
        {
          "title": "Příklady",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Ne touche pas, c'est chaud !",
                  "cs": "Nesahej na to, je to horké!"
                },
                {
                  "fr": "N'oublie pas ton sac !",
                  "cs": "Nezapomeň si tašku!"
                },
                {
                  "fr": "Ne soyez pas en retard demain.",
                  "cs": "Zítra nechoďte pozdě."
                },
                {
                  "fr": "Ne parlons plus de ça.",
                  "cs": "Už se o tom nebavme."
                },
                {
                  "fr": "Ne fais jamais ça !",
                  "cs": "Tohle nikdy nedělej!"
                }
              ]
            }
          ]
        }
      ],
