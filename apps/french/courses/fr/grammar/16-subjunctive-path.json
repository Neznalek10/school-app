        {
          "title": "Ve zkratce",
          "blocks": [
            {
              "type": "text",
              "cs": "*Il faut que* + subjonctif = **někdo** musí něco udělat: *Il faut que je parte.* (Musím odejít.) Totéž platí pro *il est important que, il est nécessaire que, il vaut mieux que* (je lepší, aby)."
            },
            {
              "type": "pattern",
              "rows": [
                {
                  "parts": [
                    [
                      "S",
                      "Il"
                    ],
                    [
                      "V",
                      "faut"
                    ],
                    [
                      "conj",
                      "que"
                    ],
                    [
                      "S",
                      "tu"
                    ],
                    [
                      "V",
                      "viennes."
                    ]
                  ],
                  "cs": "Musíš přijít."
                }
              ],
              "formula": [
