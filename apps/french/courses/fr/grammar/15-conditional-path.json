    {
      "id": "co-01-forms",
      "title": "Krok 1: Kondicionál: tvary",
      "fr": "le conditionnel présent : les formes",
      "level": "A2",
      "keywords": [
        "step by step",
        "conditional",
        "conditionnel",
        "would",
        "je voudrais",
        "je serais",
        "forms"
      ],
      "topics": [],
