    {
      "id": "co-02-uses",
      "title": "Krok 2: Použití: zdvořilé prosby, přání, rady",
      "fr": "employer le conditionnel",
      "level": "A2",
      "keywords": [
        "step by step",
        "conditional",
        "polite",
        "je voudrais",
        "j'aimerais",
        "tu devrais",
        "pourriez-vous",
