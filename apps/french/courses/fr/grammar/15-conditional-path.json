      "tense": "conditionnel-present",
      "sections": [
        {
          "title": "Ve zkratce",
          "blocks": [
            {
              "type": "text",
              "cs": "Kondicionál dělá věci jemnějšími a méně jistými. Tři běžná použití: **zdvořilé prosby** (*Je voudrais un café*), **přání** (*J'aimerais aller au Japon*) a **rady** (*Tu devrais dormir*)."
            }
          ]
        },
        {
          "title": "Zdvořilé prosby",
          "blocks": [
            {
              "type": "text",
              "cs": "*Je voudrais...* (Chtěl bych), *Pourriez-vous...?* (Mohl byste...?), *Vous auriez l'heure ?* (Nevíte, kolik je hodin?), *Ça vous dérangerait de...?* (Vadilo by vám...?)"
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "___-vous m'aider ?",
                "a": [
                  "Pourriez"
                ],
                "hint": "pouvoir",
                "cs": "Mohl bys mi pomoct?"
              }
            }
          ]
        },
        {
          "title": "Přání",
          "blocks": [
            {
              "type": "text",
              "cs": "*J'aimerais...* (Rád bych), *Je préférerais...* (Raději bych), *Ce serait génial de...* (Bylo by super...)."
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "J'___ visiter Paris.",
                "a": [
                  "aimerais"
                ],
                "hint": "aimer",
                "cs": "Rád bych navštívil Paříž."
              }
            }
          ]
        },
        {
          "title": "Rady",
          "blocks": [
            {
              "type": "text",
              "cs": "*Tu devrais...* (měl bys), *Vous pourriez...* (mohli byste), *Il faudrait...* (bylo by třeba), *À ta place, je...* (na tvém místě bych...)."
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Tu ___ te coucher plus tôt.",
                "a": [
                  "devrais"
                ],
                "hint": "devoir",
                "cs": "Měl bys chodit spát dřív."
              }
            }
          ]
        },
        {
          "title": "Příklady",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Je voudrais deux croissants, s'il vous plaît.",
