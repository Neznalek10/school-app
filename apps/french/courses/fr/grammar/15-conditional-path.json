                "tense": "conditionnel-passe",
                "person": 0
              }
            }
          ]
        },
        {
          "title": "Lítost a výčitky",
          "blocks": [
            {
              "type": "text",
              "cs": "*J'aurais dû...* (měl jsem), *J'aurais pu...* (mohl jsem), *J'aurais aimé...* (rád bych byl), *Tu aurais pu me le dire !* (Mohl jsi mi to říct!)"
