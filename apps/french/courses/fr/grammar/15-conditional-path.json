          ]
        },
        {
          "title": "Pozor",
          "blocks": [
            {
              "type": "tip",
              "cs": "Budoucí čas, nebo kondicionál? Liší se jen koncovka: *je parlerai* (budu mluvit) / *je parlerais* (mluvil bych)."
            },
            {
              "type": "tip",
              "cs": "Dvě *r* v *pourrais, verrais, courrais*, jedno v *serais, ferais, aurais*."
            }
          ]
        },
        {
          "title": "Příklady",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Je voudrais un chocolat chaud.",
                  "cs": "Dal bych si horkou čokoládu."
                },
