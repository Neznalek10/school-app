{
  "id": "negation",
  "title": "Utvoř zápor",
  "subtitle": "Jak tvořit záporné věty: ne... pas, jamais, plus, rien, personne, aucun, que, ni... ni... ve všech časech a vazbách",
  "type": "transform",
  "tags": {"ne-pas": "ne... pas", "pas-de": "pas de (členy v záporu)", "etre": "po être: pas un, pas du", "jamais": "ne... jamais", "plus": "ne... plus", "rien": "ne... rien", "personne": "ne... personne", "pas-encore": "ne... pas encore", "pas-du-tout": "ne... pas du tout", "subject": "personne ne, rien ne", "aucun": "ne... aucun(e)", "que": "ne... que (jen)", "ni-ni": "ne... ni... ni...", "nulle-part": "ne... nulle part", "combined": "Dvě záporná slova spolu", "compound": "Passé composé", "modal": "Dvě slovesa za sebou", "tenses": "Další časy", "imperative": "Záporné rozkazy", "reflexive": "Zvratná slovesa", "infinitive": "Záporný infinitiv (ne pas + sloveso)", "pronouns": "Se zájmeny", "reverse": "Převeď do kladu", "spoken": "Mluvená francouzština (bez ne)"},
  "why": {"ne-pas": "Ne stojí před časovaným slovesem (před samohláskou n') a pas za ním.", "pas-de": "Po záporu se un, une, du, de la, des mění na de (před samohláskou d').", "etre": "Po être se člen nemění: ce n'est pas un livre, ce n'est pas du chocolat.", "jamais": "Ne stojí před slovesem a jamais za ním. V passé composé: ne + avoir + jamais + příčestí.", "plus": "Ne... plus znamená už ne, už více ne. Du, de la, des se mění na de: plus de pain.", "rien": "Ne stojí před slovesem, rien za ním. V passé composé stojí rien před příčestím: je n'ai rien vu.", "personne": "Personne stojí v passé composé za příčestím: je n'ai vu personne.", "pas-encore": "Pas encore znamená ještě ne. V passé composé: je n'ai pas encore fini.", "pas-du-tout": "Ne... pas du tout znamená vůbec ne; du tout stojí za pas.", "subject": "Personne a rien můžou být podmětem: stojí na začátku a ne zůstává před slovesem. Pas se nepoužívá.", "aucun": "Aucun a aucune znamenají žádný, žádná. Shodují se s podstatným jménem a používají se v jednotném čísle. Pas se nepoužívá.", "que": "Ne... que znamená jen, pouze. Ne stojí před slovesem, que těsně před slovem, které omezuje. Člen se nemění.", "ni-ni": "Ne stojí před slovesem a každé ni před jednou ze dvou věcí. Pas se nepoužívá a člen obvykle odpadá.", "nulle-part": "Nulle part je zápor od quelque part a partout. V passé composé stojí za příčestím.", "combined": "Záporná slova se dají spojovat: jamais rien, jamais personne, plus rien, plus jamais, plus personne. Ne je jen jedno.", "compound": "V passé composé stojí ne před avoir nebo être a pas za ním, před příčestím.", "modal": "U dvou sloves obklopuje zápor to první: je ne vais pas venir, il ne peut pas venir.", "tenses": "V každém čase stojí ne před časovaným slovesem a pas za ním. V passé composé obklopuje pomocné sloveso.", "imperative": "V záporném rozkazu stojí ne před slovesem a pas za ním; zájmena zůstávají před slovesem: ne me regarde pas.", "reflexive": "Zvratné zájmeno zůstává těsně před slovesem a ne stojí před ním. Je ne me lève pas.", "infinitive": "U záporného infinitivu stojí obě části spolu před slovesem: ne pas partir, ne rien dire, ne jamais mentir.", "pronouns": "Ne stojí před zájmeny a pas za slovesem: je ne le vois pas. V passé composé: je ne l'ai pas vu.", "reverse": "Odstraň záporná slova a vrať členy: pas de viande se změní na de la viande.", "spoken": "V běžné řeči se ne často vynechává, ale v psaní a ve formální francouzštině ho potřebuješ."},
  "items": [
    {"id": "ng-ne-pas-01", "tag": "ne-pas", "level": "A1", "task_cs": "Utvoř zápor (ne... pas)", "fr": "Je parle français.", "a": ["Je ne parle pas français."]},
