    {
      "id": "elision",
      "title": "Elision: l', j', n', qu'",
      "fr": "l'élision",
      "level": "A1",
      "keywords": [
        "elision",
        "apostrophe",
        "l'",
        "j'",
        "n'",
        "qu'",
        "d'",
        "s'il",
        "m'",
        "t'",
        "élision",
        "h muet",
        "h aspiré"
      ],
      "topics": [],
      "see": [
        "liaison",
        "subject-pronouns",
        "article-definite",
        "silent-letters"
      ],
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "When a short word ends in *-e* (or *-a*) and the next word starts with a vowel or a silent *h*, the vowel drops out and an apostrophe replaces it. French dislikes two vowels in a row."
            },
            {
              "type": "table",
              "head": [
                "word",
                "before a vowel",
                "example"
              ],
              "rows": [
                [
                  "le, la",
                  "l'",
                  "l'école, l'hôtel"
                ],
                [
                  "je",
                  "j'",
                  "j'aime"
                ],
                [
                  "me, te, se",
                  "m', t', s'",
                  "je m'appelle"
                ],
                [
                  "ne",
                  "n'",
                  "je n'ai pas"
                ],
                [
                  "de",
                  "d'",
                  "beaucoup d'amis"
                ],
                [
                  "que",
                  "qu'",
                  "qu'il"
                ],
                [
                  "si (only before il, ils)",
                  "s'",
                  "s'il pleut"
                ]
              ]
            }
          ]
        },
        {
          "title": "What does not shorten",
          "blocks": [
            {
              "type": "text",
              "en": "*Tu* does not shorten in careful language (*tu as*, not *t'as*). *Si* shortens only before *il, ils* (*si elle*, not *s'elle*). The article *les* never shortens; it links instead: *les‿amis*."
            }
          ]
        },
        {
          "title": "Silent h and aspirated h",
          "blocks": [
            {
              "type": "text",
              "en": "Most words with *h* behave as if they began with a vowel (*l'homme, l'hôtel, j'habite*). Some have an *h aspiré*, which forbids both elision and liaison: *le héros, le hockey, le haricot*."
            },
            {
              "type": "compare",
              "items": [
                {
                  "en": "hockey",
                  "wrong": "l'hockey",
                  "fr": "[[le]] hockey"
                }
              ]
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "J'adore l'histoire.",
                  "en": "I love history."
                },
                {
                  "fr": "Il n'aime pas l'hiver.",
                  "en": "He doesn't like winter."
                },
                {
                  "fr": "Je pense qu'elle est malade.",
                  "en": "I think she's ill."
                },
                {
                  "fr": "S'il fait beau, on sort.",
                  "en": "If the weather is nice, we go out."
                },
                {
                  "fr": "Je joue au hockey.",
                  "en": "I play hockey."
                }
              ]
            }
          ]
        }
      ],
      "checks": [
        {
          "id": "g-elision-01",
