{
  "articles": [
    {
      "id": "accents",
      "title": "Accents and the cédille",
      "fr": "les accents",
      "level": "A1",
      "keywords": [
        "accents",
        "accent aigu",
        "accent grave",
        "accent circonflexe",
        "tréma",
        "cédille",
        "é",
        "è",
        "ê",
        "ç",
        "à",
        "où",
        "diacritics"
      ],
      "topics": [],
      "see": [
        "er-spelling",
        "silent-letters",
        "elision"
      ],
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "French accents do **not** mark stress or length. They change the sound of a vowel, or just tell two words apart."
            },
            {
              "type": "table",
              "head": [
                "mark",
                "example",
                "what it does"
              ],
              "textCols": [
                0,
                2
              ],
              "rows": [
                [
                  "accent aigu ´",
                  "é: été, café",
                  "closed e, short"
                ],
                [
                  "accent grave `",
                  "è: père, très",
                  "open e"
                ],
                [
                  "à, ù",
                  "à, où",
                  "only tells words apart"
                ],
                [
                  "accent circonflexe ^",
                  "ê, â, î, ô, û: fête, château",
                  "often in place of a vanished *s*"
                ],
                [
                  "tréma ¨",
                  "ë, ï: Noël, maïs",
                  "the vowels are pronounced separately"
                ],
                [
                  "cédille ¸",
                  "ç: français, garçon",
                  "*c* sounds like s even before a, o, u"
                ]
              ]
            }
          ]
        },
        {
          "title": "Words that an accent tells apart",
          "blocks": [
            {
              "type": "table",
              "head": [
                "without an accent",
                "with an accent"
              ],
              "rows": [
                [
                  "a (il a = has)",
                  "à (to, at)"
                ],
                [
                  "ou (or)",
                  "où (where)"
                ],
                [
                  "la (the)",
                  "là (there)"
                ],
                [
                  "sur (on)",
                  "sûr (sure)"
                ]
              ]
            },
            {
              "type": "tip",
              "en": "You can type accents with the buttons under the answer field. Whether a missing accent counts as a mistake is set in Settings."
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Mon frère est très grand.",
                  "en": "My brother is very tall."
                },
                {
                  "fr": "Où est la gare ?",
                  "en": "Where is the station?"
                },
                {
                  "fr": "Le garçon parle français.",
                  "en": "The boy speaks French."
                },
                {
                  "fr": "Je suis sûr.",
                  "en": "I'm sure."
                },
                {
                  "fr": "C'est la fête !",
                  "en": "It's a party!"
                }
              ]
            }
          ]
        }
      ],
