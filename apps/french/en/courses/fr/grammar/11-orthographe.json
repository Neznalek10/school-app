    {
      "id": "liaison",
      "title": "Liaison",
      "fr": "la liaison",
      "level": "A1",
      "keywords": [
        "liaison",
        "enchaînement",
        "les amis",
        "vous avez",
        "pronunciation",
        "linking words",
        "linking"
      ],
      "topics": [],
      "see": [
        "elision",
        "silent-letters",
        "plural"
      ],
      "sections": [
        {
          "title": "In short",
          "blocks": [
            {
              "type": "text",
              "en": "A silent final consonant **is pronounced** when the next word begins with a vowel or a silent *h*. The two words then sound like one."
            },
            {
              "type": "table",
              "head": [
                "written",
                "sounds roughly like"
              ],
              "textCols": [
                1
              ],
              "rows": [
                [
                  "les amis",
                  "le-zami"
                ],
                [
                  "vous avez",
                  "vu-zave"
                ],
                [
                  "un ami",
                  "ö-nami (nasal ö)"
                ],
                [
                  "petit enfant",
                  "peti-tanfan"
                ],
                [
                  "deux heures",
                  "dö-zör"
                ]
              ]
            }
          ]
        },
        {
          "title": "When to link",
          "blocks": [
            {
              "type": "table",
              "head": [
                "always",
                "example"
              ],
              "textCols": [
                0
              ],
              "rows": [
                [
                  "article + noun",
                  "les enfants, un ami"
                ],
                [
                  "pronoun + verb",
                  "nous avons, ils ont"
                ],
                [
                  "an adjective before a noun",
                  "un petit ami"
                ],
                [
                  "after short prepositions and adverbs",
                  "chez elle, très intéressant"
                ]
              ]
            },
            {
              "type": "tip",
              "title": "Never",
              "en": "After *et* (*et un* is not linked), before an *h aspiré* (*les héros*) and after a singular noun."
            }
          ]
        },
        {
          "title": "How the sound changes",
          "blocks": [
            {
              "type": "text",
              "en": "In a liaison *-s, -x, -z* are read as *z*, *-d* as *t*, and the *f* of *neuf* as *v* (*neuf ans*). Similarly a pronounced final consonant carries over to the next vowel: *il‿est, elle‿a*. That is why spoken French sounds like one long word."
            }
          ]
        },
        {
          "title": "Examples",
          "blocks": [
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Nous avons deux enfants.",
                  "en": "We have two children."
                },
                {
                  "fr": "Ils habitent ici.",
                  "en": "They live here."
                },
                {
                  "fr": "C'est un grand hôtel.",
                  "en": "It's a big hotel."
                },
                {
                  "fr": "Il est six heures.",
                  "en": "It's six o'clock."
                }
              ]
            }
          ]
        }
      ],
